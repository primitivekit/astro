---
export interface Props {
  label?: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search';
  size?: 'small' | 'medium' | 'large';
  placeholder?: string;
  disabled?: boolean;
  required?: boolean;
  error?: string;
  helperText?: string;
  value?: string;
}

const {
  label,
  type = 'text',
  size = 'medium',
  placeholder,
  disabled = false,
  required = false,
  error,
  helperText,
  value = '',
} = Astro.props;

const inputClasses = `pk-input pk-input--${size}${error ? ' pk-input--error' : ''}`;
---

<div class="pk-input-wrapper">
  {label && (
    <label class="pk-input__label">
      {label}
      {required && <span class="pk-input__required">*</span>}
    </label>
  )}
  <input
    class={inputClasses}
    type={type}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    value={value}
  />
  {error && <span class="pk-input__error">{error}</span>}
  {!error && helperText && <span class="pk-input__helper">{helperText}</span>}
</div>

<style>
  .pk-input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }
  .pk-input__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
  }
  .pk-input__required {
    color: #dc2626;
  }
  .pk-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    color: #1f2937;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    outline: none;
  }
  .pk-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
  .pk-input--error {
    border-color: #dc2626;
  }
  .pk-input__error {
    font-size: 0.875rem;
    color: #dc2626;
  }
  .pk-input__helper {
    font-size: 0.875rem;
    color: #6b7280;
  }
</style>
